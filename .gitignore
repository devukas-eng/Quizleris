# Dependencies
node_modules/

# Build output (regenerated from src/ on every server start)
dist/

# Secrets — never commit. Use .env.example as the template.
.env
.env.*
!.env.example

# Logs & runtime
*.log
npm-debug.log*
logs/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Test coverage
coverage/

# Local Claude Code files (launch.json holds local database credentials); shared commands stay tracked
.claude/*
!.claude/commands/

# Obsidian's own files, when docs/brain is opened as a vault
docs/brain/.obsidian/
